<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Interfaz.reservas.reservasView">
  <grid id="27dc6" binding="reservaspanel" layout-manager="GridLayoutManager" row-count="10" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="600" height="700"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- Fila 0: Label Frase | TextField frase | Botón Extraer -->
      <component id="label-frase" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Frase:"/>
        </properties>
      </component>
      <component id="textFrase" binding="textFrase" class="javax.swing.JTextField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="btnExtraer" binding="btnExtraer" class="javax.swing.JButton">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Extraer"/>
        </properties>
      </component>

      <!-- Fila 1: Label Actividad | ComboBox actividad -->
      <component id="label-actividad" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Actividad:"/>
        </properties>
      </component>
      <component id="comboActividad" binding="comboActividad" class="javax.swing.JComboBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Fila 2: Label Fecha | TextField fecha -->
      <component id="label-fecha" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Fecha:"/>
        </properties>
      </component>
      <component id="textFecha" binding="textFecha" class="javax.swing.JTextField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Fila 3: Label Hora Inicio | ComboBox horaInicio -->
      <component id="label-horaInicio" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Hora inicio:"/>
        </properties>
      </component>
      <component id="horaInicio" binding="horaInicio" class="javax.swing.JComboBox">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Fila 4: Label Hora Fin | ComboBox horaFin -->
      <component id="label-horaFin" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Hora fin:"/>
        </properties>
      </component>
      <component id="horaFin" binding="horaFin" class="javax.swing.JComboBox">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <!-- Fila 5: Label Categorías | JScrollPane con JList categorias -->
      <component id="label-categorias" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Categorías:"/>
        </properties>
      </component>
      <scrollpane id="scroll-categorias">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="categorias" binding="categorias" class="javax.swing.JList">
            <constraints/>
            <properties>
              <selectionMode value="2"/>
            </properties>
          </component>
        </children>
      </scrollpane>

      <!-- Fila 6: Botones Reservar / Cancelar / Limpiar -->
      <component id="btnReservar" binding="btnReservar" class="javax.swing.JButton">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Reservar"/>
        </properties>
      </component>
      <component id="btnCancelar" binding="btnCancelar" class="javax.swing.JButton">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cancelar"/>
        </properties>
      </component>
      <component id="btnLimpiar" binding="btnLimpiar" class="javax.swing.JButton">
        <constraints>
          <grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Limpiar"/>
        </properties>
      </component>

      <!-- Fila 7: Label Mis Reservas -->
      <component id="label-misreservas" class="javax.swing.JLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Mis reservas:"/>
        </properties>
      </component>

      <!-- Fila 8: JScrollPane con JTable tablaMisReservas -->
      <scrollpane id="scroll-tabla">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="3" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tablaMisReservas" binding="tablaMisReservas" class="javax.swing.JTable">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>

      <!-- Fila 9: Botón Imprimir -->
      <component id="btnImprimir" binding="btnImprimir" class="javax.swing.JButton">
        <constraints>
          <grid row="9" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Imprimir"/>
        </properties>
      </component>

    </children>
  </grid>
</form>
